  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: b768e54155da0d14aa06e65cae1863ba, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  text:
    en: You can capture vertical, horizontal, and diagonal rows of shapes. You can
      also capture more than one row.
    ru: "\u0412\u044B \u043C\u043E\u0436\u0435\u0442\u0435 \u0441\u043D\u0438\u043C\u0430\u0442\u044C
      \u0432\u0435\u0440\u0442\u0438\u043A\u0430\u043B\u044C\u043D\u044B\u0435, \u0433\u043E\u0440\u0438\u0437\u043E\u043D\u0442\u0430\u043B\u044C\u043D\u044B\u0435
      \u0438 \u0434\u0438\u0430\u0433\u043E\u043D\u0430\u043B\u044C\u043D\u044B\u0435
      \u0440\u044F\u0434\u044B \u0444\u0438\u0433\u0443\u0440. \u041A\u0440\u043E\u043C\u0435
      \u0442\u043E\u0433\u043E \u0432\u044B \u043C\u043E\u0436\u0435\u0442\u0435
      \u0437\u0430\u0445\u0432\u0430\u0442\u0438\u0442\u044C \u0431\u043E\u043B\u0435\u0435
      \u043E\u0434\u043D\u043E\u0439 \u0441\u0442\u0440\u043E\u043A\u0438."
