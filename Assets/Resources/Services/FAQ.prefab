  m_text: "\u0418\u0433\u0440\u0430 \u043D\u0430\u0447\u0438\u043D\u0430\u0435\u0442\u0441\u044F
    \u0441 \u0434\u0432\u0443\u043C\u044F \u0444\u0438\u0448\u043A\u0430\u043C\u0438
    \u043A\u0430\u0436\u0434\u043E\u0433\u043E \u0446\u0432\u0435\u0442\u0430 \u043D\u0430
    \u0434\u043E\u0441\u043A\u0435, \u0438 \u0438\u0433\u0440\u043E\u043A\u0438 \u0434\u043E\u043B\u0436\u043D\u044B
    \u043F\u043E \u043E\u0447\u0435\u0440\u0435\u0434\u0438 \u043F\u043E\u043F\u044B\u0442\u0430\u0442\u0441\u044F
    \u0437\u0430\u0445\u0432\u0430\u0442\u0438\u0442\u044C \u0444\u0438\u0448\u043A\u0443
    \u043F\u0440\u043E\u0442\u0438\u0432\u043D\u0438\u043A\u0430."
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 8f586378b4e144a9851e7b34d9b748ee, type: 2}
